# NCC AI Learning Portal - Environment Template
# Copy this file to .env and fill in your Gemini API key.
# Get a free Gemini API key: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000

# Google OAuth 2.0 Client ID for Real Google One-Tap & Sign-In
# Create your Web Client ID at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

